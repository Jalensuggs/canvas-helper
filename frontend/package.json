{
  "name": "canvas-helper-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty false",
    "test": "tsc -b --pretty false && vitest run",
    "desktop:sidecar": "python3 ../scripts/build_sidecar.py",
    "desktop:dev": "npm run desktop:sidecar && tauri dev --config ../src-tauri/tauri.conf.json",
    "desktop:build": "npm run desktop:sidecar && tauri build --config ../src-tauri/tauri.conf.json"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.66.8",
    "dompurify": "^3.2.4",
    "lucide-react": "^0.475.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.8.4",
    "@types/dompurify": "^3.0.5",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^25.0.1",
    "typescript": "~5.7.3",
    "vite": "^6.1.0",
    "vitest": "^3.2.7"
  }
}
