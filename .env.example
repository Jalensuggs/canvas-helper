# Public application settings only. Store the Canvas token in the setup screen.
CANVAS_HELPER_DATABASE_URL=sqlite+aiosqlite:///./data/canvas_helper.db
CANVAS_HELPER_DATA_DIR=./data
CANVAS_HELPER_CANVAS_BASE_URL=https://canvas.uts.edu.au
CANVAS_HELPER_DEPLOYMENT_MODE=local_desktop
CANVAS_HELPER_ENVIRONMENT=development
CANVAS_HELPER_DEBUG=false

# Academic calendar used to infer the current teaching period when Canvas
# omits term dates. Lists are comma-separated.
CANVAS_HELPER_ACADEMIC_TIMEZONE=Australia/Sydney
CANVAS_HELPER_TERM_START_MONTHS=1,7

# Optional AI provider. Export the real key in your shell; choose a model
# currently supported by your Anthropic account.
CANVAS_HELPER_ANTHROPIC_API_KEY=
CANVAS_HELPER_ANTHROPIC_MODEL=

# Docker/server mode. Uncomment and replace every value before
# `docker compose --env-file .env up -d --build`.
# POSTGRES_PASSWORD=change-me
# CANVAS_HELPER_DEPLOYMENT_MODE=server
# CANVAS_HELPER_ENVIRONMENT=production
# CANVAS_HELPER_DATABASE_URL=postgresql+asyncpg://canvas:change-me@postgres:5432/canvas
# CANVAS_HELPER_PUBLIC_URL=https://canvas.example.com
# CANVAS_HELPER_CREDENTIAL_ENCRYPTION_KEY=generate-a-32-byte-urlsafe-base64-key
# CANVAS_HELPER_EMAIL_BACKEND=smtp
# CANVAS_HELPER_EMAIL_FROM=Canvas Helper <noreply@example.com>
# CANVAS_HELPER_SMTP_HOST=smtp.example.com
# CANVAS_HELPER_SMTP_PORT=587
# CANVAS_HELPER_SMTP_USERNAME=change-me
# CANVAS_HELPER_SMTP_PASSWORD=change-me
# CANVAS_HELPER_PORT=8000

# Sign-in is open to anyone who can reach the site unless you restrict it.
# Comma-separated; leave unset to allow every domain.
# CANVAS_HELPER_ALLOWED_EMAIL_DOMAINS=student.uts.edu.au,uts.edu.au

# Anti-abuse limits for the unauthenticated magic-link endpoint. Set either to
# 0 to disable that half of the check.
# CANVAS_HELPER_MAGIC_LINK_PER_EMAIL_PER_HOUR=5
# CANVAS_HELPER_MAGIC_LINK_PER_IP_PER_HOUR=20

# Implicit TLS for SMTP on port 465. Port 465 enables this automatically.
# CANVAS_HELPER_SMTP_USE_SSL=true
# CANVAS_HELPER_SMTP_TIMEOUT_SECONDS=15

# Retention sweeps. Days of history to keep; 0 disables an individual sweep.
# CANVAS_HELPER_SYNC_JOB_RETENTION_DAYS=7
# CANVAS_HELPER_MAGIC_LINK_RETENTION_DAYS=1
# CANVAS_HELPER_USER_SESSION_RETENTION_DAYS=7
# CANVAS_HELPER_NOTE_REVISION_KEEP_PER_NOTE=50
